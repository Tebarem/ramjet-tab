<Project Sdk="Microsoft.NET.Sdk">
  <!-- Out-of-server tests for src/Core: the config model, the compiler, the resolver, the sorter and the placeholder token scanner are compiled in directly.
       They use no game API, so no engine build is needed. No NuGet packages. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Tab.Tests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="../../src/Core/**/*.cs" />
  </ItemGroup>
</Project>
